<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="neuroflip.NeuroFlip.LeaderboardController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Text text="Leaderboard" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
    <TableView fx:id="leaderboardTable" prefHeight="400" prefWidth="600">
        <columns>
            <TableColumn fx:id="serialColumn" text="Serial No." prefWidth="100"/>
            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="250"/>
            <TableColumn fx:id="highestScoreColumn" text="Highest Score" prefWidth="250"/>
        </columns>
    </TableView>
    <Button fx:id="backButton" text="Back to Dashboard" onAction="#handleBack"/>
</VBox>